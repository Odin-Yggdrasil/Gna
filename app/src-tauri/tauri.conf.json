{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gná",
  "version": "0.14.1",
  "identifier": "ovh.gjallarbru.gna",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "nsis",
      "msi"
    ],
    "category": "Utility",
    "shortDescription": "Bastion d'accès SSH, VNC et RDP",
    "longDescription": "Client du bastion Gná : accès aux machines en SSH, VNC et RDP, avec certificat du serveur épinglé.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "section": "net"
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "languages": [
          "French"
        ],
        "installMode": "currentUser"
      }
    }
  }
}
