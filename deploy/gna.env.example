# Configuration de Gná — /etc/gna/gna.env
# Droits obligatoires : root:gna, 640 (Gná refuse de démarrer si le fichier est lisible par tous).

# Base locale par socket Unix : aucun mot de passe, PostgreSQL authentifie
# l'utilisateur système « gna » (authentification « peer »).
GNA_DATABASE_URL=postgres:///gna?host=/var/run/postgresql

# Clé maître de chiffrement (32 octets en base64), générée par install.sh.
# À SAUVEGARDER À PART : sans elle, les secrets chiffrés en base sont perdus.
GNA_MASTER_KEY=

# Adresse d'écoute. 0.0.0.0 = joignable par l'IP du serveur depuis le réseau.
# Mettre 127.0.0.1:8443 pour n'autoriser que la machine elle-même.
GNA_LISTEN=0.0.0.0:8443

# HTTPS avec un certificat auto-signé, créé au premier démarrage dans /var/lib/gna/tls.
# Le navigateur affichera un avertissement : vérifier l'empreinte avec « sudo -u gna gna tls info ».
GNA_TLS_SELF_SIGNED=true

# Ou un vrai certificat (Let's Encrypt, PKI interne) à la place du certificat auto-signé :
#GNA_TLS_SELF_SIGNED=false
#GNA_TLS_CERT=/etc/gna/tls/fullchain.pem
#GNA_TLS_KEY=/etc/gna/tls/privkey.pem

# true seulement si Gná écoute sur 127.0.0.1 derrière un reverse proxy qui ajoute X-Forwarded-For.
GNA_TRUST_PROXY=false

# Enregistrement des sessions (fichiers chiffrés dans /var/lib/gna/recordings)
#GNA_RECORD_SESSIONS=true
# Sessions VNC (par défaut : même valeur que GNA_RECORD_SESSIONS). Plus volumineux que le SSH.
#GNA_RECORD_VNC=true
# Enregistrer aussi les frappes clavier (attention : inclut les mots de passe tapés, ex. sudo)
#GNA_RECORD_INPUT=false
# Durée de conservation en jours (0 = illimitée)
#GNA_RECORDING_RETENTION_DAYS=90

# Valeurs par défaut, à décommenter pour les changer :
#GNA_SESSION_TTL=12h
#GNA_IDLE_TIMEOUT=30m
# Après inactivité, le mot de passe seul déverrouille la session tant que le dernier
# code TOTP date de moins de cette durée (« off » : code TOTP à chaque fois).
#GNA_MFA_REMEMBER=4h
#GNA_MAX_FAILURES=5
#GNA_LOCK_DURATION=15m
#GNA_ISSUER=Gná

# --- Outils des bureaux à distance ---
# Copier-coller entre le navigateur et la machine distante (RDP et VNC).
#GNA_CLIPBOARD=true
# Transfert de fichiers RDP : lecteur « Gna » sur la machine distante.
#GNA_FILE_TRANSFER=true
# Taille maximale du dossier de transfert d'une session (Mo).
#GNA_TRANSFER_MAX_MB=1024
